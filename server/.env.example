# Database Configuration
MONGO_URI=mongodb://localhost:27017/codefusion

# Server Configuration
PORT=5000
NODE_ENV=development

# AI Provider Configuration
# Recommended free-tier provider: Groq (OpenAI-compatible)
AI_PROVIDER=groq
AI_API_KEY=your_groq_api_key_here
AI_MODEL=llama-3.1-8b-instant
AI_API_URL=https://api.groq.com/openai/v1/chat/completions

# Optional compatibility variables
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# JWT Secret (keep this secure!)
JWT_SECRET=your_jwt_secret_key_here

# Frontend URL for CORS (optional)
CLIENT_URL=http://localhost:5173

# Piston API (Code Execution)
PISTON_MODE=docker
# If using external Piston:
# PISTON_MODE=public
# PISTON_PUBLIC_URL=https://emkc.org
# PISTON_URL=http://localhost:2000
